<?xml version="1.0" encoding="UTF-8"?>
<configuration>

  <!-- Sourced from Spring environment; resolved before any appender. -->
  <springProperty scope="context" source="spring.application.name" name="APPLICATION_NAME" />
  <springProperty scope="context" source="logging.file.path" name="LOG_DIR" defaultValue="./logs" />

  <!-- Console appender (development only) -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <!-- ... pattern ... -->
    </encoder>
  </appender>

  <!-- Async file appender (all profiles) -->
  <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
    <appender-ref ref="FILE" />
  </appender>

  <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_DIR}/${APPLICATION_NAME}.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${LOG_DIR}/${APPLICATION_NAME}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
      <maxFileSize>10MB</maxFileSize>
      <totalSizeCap>1GB</totalSizeCap>
      <maxHistory>7</maxHistory>
    </rollingPolicy>
    <encoder>
      <!-- ... pattern ... -->
    </encoder>
  </appender>

  <!-- development: console + async file at INFO -->
  <springProfile name="development">
    <root level="INFO">
      <appender-ref ref="CONSOLE" />
      <appender-ref ref="ASYNC_FILE" />
    </root>
  </springProfile>

  <!-- production and default: async file only at INFO -->
  <springProfile name="production,default">
    <root level="INFO">
      <appender-ref ref="ASYNC_FILE" />
    </root>
  </springProfile>

</configuration>