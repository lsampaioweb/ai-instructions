<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  namespace must exactly match the fully qualified name of the Java mapper interface.
  Example: com.example.resource.ResourceMapper
-->
<mapper namespace="com.example.resource.ResourceMapper">

  <resultMap id="resourceMap" type="com.example.resource.Resource">
    <id property="id" column="id" />
    <result property="name" column="name" />
    <result property="description" column="description" />
  </resultMap>

  <select id="findAll" resultMap="resourceMap">
    <!-- ... -->
  </select>

  <select id="findById" parameterType="long" resultMap="resourceMap">
    <!-- ... -->
  </select>

  <insert id="insert" useGeneratedKeys="true" keyProperty="id">
    <!-- ... -->
  </insert>

  <update id="update">
    <!-- ... -->
  </update>

  <delete id="deleteById" parameterType="long">
    <!-- ... -->
  </delete>

</mapper>